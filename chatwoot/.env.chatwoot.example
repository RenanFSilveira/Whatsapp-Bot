# =============================================================================
# Chatwoot Environment — Turbo Track
# Copy to .env.chatwoot and fill in real values before deploying.
# NEVER commit .env.chatwoot to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Rails
# -----------------------------------------------------------------------------
SECRET_KEY_BASE=REPLACE_WITH_64_CHAR_HEX  # openssl rand -hex 64
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Public URL of this Chatwoot instance (used in emails, webhook callbacks, etc.)
# For VPS: http://<VPS_IP>:3000  or  https://chat.yourdomain.com
FRONTEND_URL=http://REPLACE_WITH_VPS_IP_OR_DOMAIN:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=chatwoot_production
# Full URL — used by Rails. Must match the credentials above.
DATABASE_URL=postgresql://chatwoot:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/chatwoot_production

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
# Used by Rails. Must include the password.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# -----------------------------------------------------------------------------
# Email / SMTP (needed for user invites and notifications)
# Can be left minimal for headless / API-only use.
# -----------------------------------------------------------------------------
MAILER_SENDER_EMAIL=no-reply@REPLACE_WITH_DOMAIN
SMTP_DOMAIN=REPLACE_WITH_DOMAIN
SMTP_ADDRESS=smtp.REPLACE_WITH_PROVIDER.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
# Set to true to skip certificate verification (not recommended in production)
SMTP_OPENSSL_VERIFY_MODE=none

# -----------------------------------------------------------------------------
# Storage (default: local disk; switch to S3 for production scale)
# -----------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=local
# If switching to S3:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=REPLACE
# AWS_ACCESS_KEY_ID=REPLACE
# AWS_SECRET_ACCESS_KEY=REPLACE
# AWS_REGION=REPLACE

# -----------------------------------------------------------------------------
# Chatwoot feature flags
# -----------------------------------------------------------------------------
INSTALLATION_NAME=TurboTrack
# Set to true to disable user sign-ups (headless / API-only tenants managed programmatically)
DISABLE_USER_SIGNUP=false
# Required to create accounts via the Super Admin API
SUPER_ADMIN_EMAIL=admin@REPLACE_WITH_DOMAIN

# -----------------------------------------------------------------------------
# Performance / Workers
# Tune DOWN for memory-constrained VPS (e.g. 2GB total RAM with existing services)
# -----------------------------------------------------------------------------
# Low-memory profile (VPS with <2GB free): WEB_CONCURRENCY=1, SIDEKIQ_CONCURRENCY=5
# Standard profile (2–4GB free):           WEB_CONCURRENCY=2, SIDEKIQ_CONCURRENCY=10
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3
SIDEKIQ_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Memory limits (Docker hard caps — tune based on `free -h` output on VPS)
# Reduce these values if the VPS has less than 2GB free RAM.
# Total ceiling with defaults: ~1.5GB
# -----------------------------------------------------------------------------
MEM_LIMIT_POSTGRES=256m
MEM_LIMIT_REDIS=256m
MEM_LIMIT_WEB=512m
MEM_LIMIT_WORKER=512m

# -----------------------------------------------------------------------------
# Port (used by docker-compose.yml host-side binding)
# Check that this port is free on the VPS before deploying: ss -tlnp | grep 3000
# -----------------------------------------------------------------------------
CHATWOOT_PORT=3000
