# Supabase — backend (service role, bypasses RLS)
# SUPABASE_URL comes from NEXT_PUBLIC_SUPABASE_URL in the Supabase project settings
# SUPABASE_SERVICE_KEY comes from SUPABASE_SERVICE_ROLE_KEY (never expose this in the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# JWT — must match the key used to mint tokens for tenants
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=turbo-track
