# Supabase connection — required for integration tests and production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT signing — must match the key used by Supabase Auth or your auth service
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=turbo-track
