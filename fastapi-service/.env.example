# Supabase — backend (service role, bypasses RLS)
# SUPABASE_URL comes from NEXT_PUBLIC_SUPABASE_URL in the Supabase project settings
# SUPABASE_SERVICE_KEY comes from SUPABASE_SERVICE_ROLE_KEY (never expose this in the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# JWT — must match the key used to mint tokens for tenants
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=turbo-track

# Chatwoot — get from chat.respondipravoce.com.br → Perfil → API Access Token
CHATWOOT_URL=https://chat.respondipravoce.com.br
CHATWOOT_API_TOKEN=<your-api-access-token>
CHATWOOT_ACCOUNT_ID=1

# Evolution API — for outbound messages (sending from FastAPI)
EVOLUTION_API_URL=https://evo.respondipravoce.com.br
EVOLUTION_API_KEY=<your-evolution-api-key>

# Forward webhook events to this URL after processing (optional — keeps n8n flow alive)
WEBHOOK_FORWARD_URL=https://n8n.respondipravoce.com.br/webhook/whatsapp-grupos
